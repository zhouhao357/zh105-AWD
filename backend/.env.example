# 数据库凭据示例（复制为 .env 后按本机实际情况修改，.env 已被 .gitignore 忽略）
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhou_campus_market

# 服务端口（固定端口 8325，与实验指导书一致）
PORT=8325
# 大模型接口（SiliconFlow，OpenAI 兼容协议）
LLM_API_KEY=你的大模型API密钥
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash


# 上下文控制：保留最近 N 轮原文，超出预算的早期消息压缩为摘要
LLM_KEEP_ROUNDS=6
LLM_CTX_BUDGET=4000
# 知识库切片目标字数
KB_CHUNK_SIZE=300
# 费用估算单价（元 / 百万 token）
LLM_PRICE_INPUT=2
LLM_PRICE_OUTPUT=8
